{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Vox: GUI",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "console": "integratedTerminal",
      "justMyCode": false,
      "python": "/Library/Frameworks/Python.framework/Versions/3.13/bin/python3",
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      }
    },
    {
      "name": "Vox: pytest",
      "type": "python",
      "request": "launch",
      "module": "pytest",
      "args": ["-v", "tests/"],
      "console": "integratedTerminal",
      "justMyCode": false,
      "python": "/Library/Frameworks/Python.framework/Versions/3.13/bin/python3"
    }
  ]
}
